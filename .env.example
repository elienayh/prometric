# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Supabase configuration
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Client-side Supabase configuration (only public variables)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ProMetric AI symmetric encryption key (Server-only secret)
PROMETRIC_AI_ENCRYPTION_KEY=""
# Optional legacy secret key for decrypting records created before master key rotation
PROMETRIC_AI_LEGACY_DECRYPT_KEY=""

# Google Gemini OAuth configuration (Server-only secret)
GOOGLE_GEMINI_OAUTH_CLIENT_ID=""
GOOGLE_GEMINI_OAUTH_CLIENT_SECRET=""
